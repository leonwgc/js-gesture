{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "js-gesture": ["./src/index.ts"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests", "demo"]
}
